{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Рекомендации: пользователь 1",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/recommend.py",
      "args": ["--user-id", "1", "--n", "10"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pipeline: быстрая проверка",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "args": ["--quick", "--reuse-classical"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pipeline: полное обучение",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Two-Tower: feature ablation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/feature_ablation.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pytest: все тесты",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
